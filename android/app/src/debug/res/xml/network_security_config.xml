<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (overrides src/main/res/xml/network_security_config.xml).
  Same as release, plus cleartext HTTP to a local backend: localhost (USB phone with
  `adb reverse tcp:8000 tcp:8000`) and 10.0.2.2 (the Mac host from the emulator).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
