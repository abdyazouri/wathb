<?xml version="1.0" encoding="utf-8"?>
<!--
  Release (and default): HTTPS only. The production API is
  https://wathb-api2.onrender.com/api/v1/. Do not add domain-config entries here.
  Debug builds use src/debug/res/xml/network_security_config.xml instead, which also
  allows cleartext HTTP to a local backend.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
